# Copier en .env et renseigner. .env est gitignoré — aucun secret dans le repo.

# --- Base de données (Neon Postgres) -------------------------------------
# Soit une URL de connexion complète (recommandé, prendre l'URL -pooler de Neon)…
DB_CONNECTION_STRING=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/stormtracker?sslmode=require
# …soit les champs séparés (utilisés seulement si DB_CONNECTION_STRING est absent) :
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
# Mettre "disable" pour une base locale sans TLS (tests). Vide = TLS (Neon).
DB_SSL=

# --- Serveur ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- CORS -------------------------------------------------------------
# Liste blanche d'origines séparées par des virgules. Vide = toutes les
# origines autorisées (dev uniquement — un avertissement est loggé).
CORS_ORIGINS=http://localhost:5173

# --- Page de santé /status -------------------------------------------
# Jeton exigé pour /status et /status/data. Non défini => /status renvoie 503.
STATUS_TOKEN=

# Mettre "off" pour ne pas journaliser les requêtes dans request_logs.
REQUEST_LOG=
